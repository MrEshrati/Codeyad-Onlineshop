<%- include('../includes/head.ejs') %> <%- include('../includes/header.ejs') %>
<%- include('../includes/nav.ejs') %>

<main>
    <% if(orders.length > 0) { %>
        <ul class="orders">
            <% orders.forEach(order => { %>
                <li class="orders_item">
                    <h1>سفارش - <%= order._id %>  - <a href="/invoices/<%= order._id %>">گزارش</a></h1>
                    <ul class="orders_products">
                        <% order.products.forEach(p => { %>
                            <li class="orders_products_item"><%= p.product.title %> <br> ( <%= p.quantity %> )</li>
                        <% }); %>
                    </ul>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <h1>سفارشی ثبت نشده است...</h1>
    <% } %>
</main>

<%- include('../includes/end.ejs') %>